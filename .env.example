# User access token (oauth.vk.com → access_token=...)

VK_TOKEN=



# Опционально; если пусто — определится автоматически

VK_USER_ID=0

# Второй аккаунт (опционально)
VK_TOKEN_2=
VK_USER_ID_2=0

# Обложка профиля: время по МСК, автообновление в начале каждой минуты



# На Windows при ошибке SSL: false. На Bothost/Linux оставь true или убери.

VK_SSL_VERIFY=true



# --- Меню функций (Hell Bot | LP) ---

# «нд» — статус всех функций, «нд помощь» — описание команд.

# «нд вкл онлайн» / «нд выкл пуши» (только исходящие владельца):

# автодобавление, онлайн, оффлайн, удаление собак / собаки,

# автоотписка, удаление пушей / пуши, удаление массовых пушей / массовые пуши,

# автовыход, повторялка, удалялка

# Повторялка: «..текст»  |  Удалялка: «дд» (10 шт.) / «дд5»  |  Умная: reply + «дд»
# нд удалялка <слово>  |  нд редач <фраза>
# л инфо  |  л ловушка  |  л +гс/-гс/гс  |  нд префикс <буква>

# Состояние: data/features.json

